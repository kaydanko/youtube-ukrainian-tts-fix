  "language": "uk-UA",
  "name": "Ukrainian TTS Fixed-Stress Lexicon",
  "description": "Community-maintained lexicon of Ukrainian wordforms with authoritative fixed lexical stress, intended for ingestion by Text-to-Speech / automated dubbing pipelines.",
  "license": "MIT",
  "updated": "2026-11-06",
  "normative_references": [
    "Орфоепічний словник української мови (Інститут української мови НАН України)",
    "Словник української мови у 20 томах (СУМ-20)",
    "Український правопис (редакція 2019 року)"
  ],
  "notation": {
    "uppercase": {
      "description": "The stressed vowel is written as a single uppercase letter; all other letters are lowercase. Serialization format only: engines MUST match against the lowercase 'form'.",
      "example": "водА"
    },
    "combining": {
      "description": "U+0301 COMBINING ACUTE ACCENT placed immediately after the stressed vowel. Strings are kept in NFC; Cyrillic vowels have no precomposed acute forms, so the mark stays a separate code point.",
      "codepoint": "U+0301",
      "example": "вода\u0301"
    },
    "stress_char_index": "0-based index (in Unicode code points) of the stressed vowel inside 'form'.",
    "stress_syllable": "1-based ordinal of the stressed syllable, counted from the start of the word.",
    "grammemes": "Universal Dependencies (UD v2) feature names and values, lowercased keys (case, number, gender, tense, verb_form, aspect, num_type)."
  },
  "status_values": {
    "seed": "Initial entry checked against the normative references; awaiting independent review by a second contributor.",
    "verified": "Confirmed by at least two independent reviewers with a cited normative source.",
    "deprecated": "Kept for traceability; MUST NOT be applied."
  },
  "matching": {
    "unit": "whole_word",
    "case_sensitive": false,
    "apostrophe_normalization": ["'", "’", "ʼ"],
    "homograph_policy": "Entries with 'homograph': true share the same surface 'form' with a different stress. Apply them only after morphological disambiguation (grammemes); 'context_hints' are a fallback heuristic, not a rule."
  },
